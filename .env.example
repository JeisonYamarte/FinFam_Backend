# Application
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=FINFAMDB
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/FINFAMDB?schema=public

# Auth
JWT_SECRET=replace-with-a-strong-secret

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=60000

# Email
EMAIL_FROM=noreply@finfam.local
EMAIL_PASSWORD=replace-with-email-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
