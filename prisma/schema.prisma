// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id          String   @id @default(uuid())
  name        String
  lastName    String
  birthDate   DateTime
  email       String   @unique
  password    String
  verifiedEmail   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships      Memberships[]
  expensesPaid     ExpensePayers[]
  splits           ExpenseSplits[]
  sessions         Sessions[]
  expensesCreated  Expenses[]     @relation("ExpenseCreator")
}

model Sessions {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  ip           String?
  userAgent    String?

  user         Users    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Households {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Memberships[]
  expenses    Expenses[]
  closures    Closures[]
}

model Memberships {
  id          String   @id @default(uuid())
  userId      String
  householdId String
  role        Role     @default(GUEST)
  isActive    Boolean  @default(true)

  user        Users      @relation(fields: [userId], references: [id])
  household   Households @relation(fields: [householdId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, householdId])
}

enum Role {
  ADMIN
  GUEST
}

model Expenses {
  id           String   @id @default(uuid())
  title        String
  description  String?
  amount       Decimal  @db.Decimal(12,2)
  date         DateTime
  receiptUrl   String?
  receiptPublicId String?  

  householdId  String
  closureId    String?
  createdBy    String

  household    Households @relation(fields: [householdId], references: [id])
  closure      Closures?  @relation(fields: [closureId], references: [id])
  creator      Users      @relation("ExpenseCreator", fields: [createdBy], references: [id])

  payers       ExpensePayers[]
  splits       ExpenseSplits[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([householdId])
  @@index([closureId])
}

model ExpenseSplits {
  id        String   @id @default(uuid())
  expenseId String
  userId    String
  amount    Decimal  @db.Decimal(12,2)

  expense   Expenses @relation(fields: [expenseId], references: [id])
  user      Users    @relation(fields: [userId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([expenseId, userId])
}

model ExpensePayers {
  id          String   @id @default(uuid())
  expenseId   String
  userId      String
  amountPaid  Decimal  @db.Decimal(12,2)

  expense     Expenses @relation(fields: [expenseId], references: [id])
  user        Users    @relation(fields: [userId], references: [id])

  updatedAt   DateTime @updatedAt

  @@unique([expenseId, userId])
  @@index([expenseId])
}

model Closures {
  id           String   @id @default(uuid())
  householdId  String

  startDate    DateTime
  endDate      DateTime

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  household    Households @relation(fields: [householdId], references: [id])
  expenses     Expenses[]
  balances     ClosureBalance[]

  @@index([householdId])
}

model ClosureBalance {
  id          String   @id @default(uuid())
  closureId   String
  fromUserId  String
  toUserId    String
  amount      Decimal  @db.Decimal(12,2)

  closure     Closures @relation(fields: [closureId], references: [id])

  updatedAt   DateTime @updatedAt

  @@index([closureId])
}