// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(uuid())
  name        String
  lastName    String
  birthDate   DateTime
  email       String   @unique
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  expensesPaid Expense[]      @relation("PaidBy")
  splits       ExpenseSplit[]
}

model Household {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  expenses    Expense[]
  closures    Closure[]
}

model Membership {
  id          String   @id @default(uuid())
  userId      String
  householdId String
  role        Role     @default(GUEST)

  user        User      @relation(fields: [userId], references: [id])
  household   Household @relation(fields: [householdId], references: [id])

  createdAt   DateTime @default(now())

  @@unique([userId, householdId])
}

enum Role {
  ADMIN
  GUEST
}

model Expense {
  id           String   @id @default(uuid())
  title        String
  description  String?
  amount       Decimal  @db.Decimal(12,2)
  date         DateTime

  householdId  String
  paidById     String
  closureId    String?

  household    Household @relation(fields: [householdId], references: [id])
  paidBy       User      @relation("PaidBy", fields: [paidById], references: [id])
  closure      Closure?  @relation(fields: [closureId], references: [id])

  splits       ExpenseSplit[]

  createdAt    DateTime @default(now())

  @@index([householdId])
  @@index([closureId])
}

model ExpenseSplit {
  id        String   @id @default(uuid())
  expenseId String
  userId    String
  amount    Decimal  @db.Decimal(12,2)

  expense   Expense @relation(fields: [expenseId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model Closure {
  id           String   @id @default(uuid())
  householdId  String

  startDate    DateTime
  endDate      DateTime

  createdAt    DateTime @default(now())

  household    Household @relation(fields: [householdId], references: [id])
  expenses     Expense[]
  balances     ClosureBalance[]

  @@index([householdId])
}

model ClosureBalance {
  id          String   @id @default(uuid())
  closureId   String
  fromUserId  String
  toUserId    String
  amount      Decimal  @db.Decimal(12,2)

  closure     Closure @relation(fields: [closureId], references: [id])

  @@index([closureId])
}